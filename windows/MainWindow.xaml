<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.Web.WebView2.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Visibility="Collapsed" ToolTipService.ToolTip="Back to latest" Click="Back_Click" />
                    <TextBlock Grid.Column="1" x:Name="SidebarTitle" Text="Latest" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Background="Transparent" ToolTipService.ToolTip="Refresh" Click="Refresh_Click" />
                </Grid>

                <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search the archive (Enter)" KeyDown="SearchBox_KeyDown" IsEnabled="False" />

                <ListView Grid.Row="2" x:Name="Topics" SelectionMode="Single" SelectionChanged="Topics_SelectionChanged" IsEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:WebView2 Grid.Column="1" x:Name="Reader" DefaultBackgroundColor="Transparent" />

            <ProgressRing Grid.Column="1" x:Name="Loading" Width="44" Height="44" IsActive="True" Visibility="Collapsed" />
        </Grid>

        <InfoBar Grid.Row="1" x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Error" Message="" CloseButtonClick="StatusBar_Close" />
    </Grid>
</Window>
