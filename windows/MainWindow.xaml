<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Visibility="Collapsed" ToolTipService.ToolTip="Back to latest" Click="Back_Click" />
                    <TextBlock Grid.Column="1" x:Name="SidebarTitle" Text="Latest" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="SummarizeButton" Content="Summarize" Background="Transparent" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="AI summary of this thread (threadly ai-config)" Click="Summarize_Click" />
                    <Button Grid.Column="3" x:Name="TranslateButton" Content="Translate" Background="Transparent" Padding="6,4" IsEnabled="False" ToolTipService.ToolTip="AI translation of this thread" Click="Translate_Click" />
                    <Button Grid.Column="4" x:Name="ReplyButton" Content="&#xE97A;" FontFamily="Segoe MDL2 Assets" Background="Transparent" IsEnabled="False" ToolTipService.ToolTip="Reply to this topic" Click="Reply_Click" />
                    <Button Grid.Column="5" x:Name="AccountButton" Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" Background="Transparent" ToolTipService.ToolTip="Sign in" Click="Account_Click" />
                    <Button Grid.Column="6" Content="&#xE895;" FontFamily="Segoe MDL2 Assets" Background="Transparent" ToolTipService.ToolTip="Check for updates" Click="CheckForUpdates_Click" />
                    <Button Grid.Column="7" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Background="Transparent" ToolTipService.ToolTip="Refresh" Click="Refresh_Click" />
                </Grid>

                <ComboBox Grid.Row="1" x:Name="CategoryPicker" HorizontalAlignment="Stretch" SelectionChanged="CategoryPicker_SelectionChanged" IsEnabled="False" PlaceholderText="Latest" />

                <TextBox Grid.Row="2" x:Name="SearchBox" PlaceholderText="Search the archive (Enter)" KeyDown="SearchBox_KeyDown" IsEnabled="False" />

                <ListView Grid.Row="3" x:Name="Topics" SelectionMode="Single" SelectionChanged="Topics_SelectionChanged" IsEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ContentControl Grid.Column="1" x:Name="ReaderHost" />

            <ProgressRing Grid.Column="1" x:Name="Loading" Width="44" Height="44" IsActive="True" Visibility="Collapsed" />
        </Grid>

        <InfoBar Grid.Row="1" x:Name="StatusBar" IsOpen="False" IsClosable="True" Severity="Error" Message="" CloseButtonClick="StatusBar_Close" />
    </Grid>
</Window>
